{
  "name": "voices-web",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "biome": "biome",
    "typecheck": "tsc -b",
    "build": "pnpm run typecheck && vite build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "acceptance": "node ./tests/run-e2e.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.2.2"
  }
}
