{
  "name": "voices-web",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.12.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "biome": "biome",
    "typecheck": "tsc -b",
    "build": "pnpm run typecheck && vite build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "acceptance": "node ./tests/run-e2e.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "basedpyright": "^1.40.2",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
